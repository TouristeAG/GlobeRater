<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Progress Bar Background -->
    <ProgressBar
        android:id="@+id/budget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/vertical_budget_progress_background_no_outline" />

    <!-- Central Plus Buttons - one will be shown based on size -->
    <Button
        android:id="@+id/btn_add_to_budget_small"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal|center_vertical"
        android:layout_marginTop="-10dp"
        android:background="@drawable/fab_plus_background"
        android:text="+"
        android:textAllCaps="false"
        android:textColor="@color/dynamic_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_add_to_budget_medium"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal|center_vertical"
        android:layout_marginTop="-10dp"
        android:background="@drawable/fab_plus_background"
        android:text="+"
        android:textAllCaps="false"
        android:textColor="@color/dynamic_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_add_to_budget_xlarge"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal|center_vertical"
        android:layout_marginTop="-10dp"
        android:background="@drawable/fab_plus_background"
        android:text="+"
        android:textAllCaps="false"
        android:textColor="@color/dynamic_primary"
        android:textSize="40sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_add_to_budget_large"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal|center_vertical"
        android:layout_marginTop="-10dp"
        android:background="@drawable/fab_plus_background"
        android:text="+"
        android:textAllCaps="false"
        android:textColor="@color/dynamic_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:visibility="gone" />

    <!-- Budget Amount Display - multiple sizes like buttons -->
    <TextView
        android:id="@+id/budget_amount_text_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:text="88,67 EUR"
        android:textColor="@color/dynamic_primary"
        android:textSize="10sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/budget_amount_text_medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:text="88,67 EUR"
        android:textColor="@color/dynamic_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/budget_amount_text_large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:text="88,67 EUR"
        android:textColor="@color/dynamic_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/budget_amount_text_xlarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:text="88,67 EUR"
        android:textColor="@color/dynamic_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-black"
        android:gravity="center_horizontal"
        android:visibility="gone" />

</FrameLayout>