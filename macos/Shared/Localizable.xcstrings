        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा अवधि के खर्च अब नहीं गिने जाएँगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengeluaran periode ini tidak akan dihitung lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spese del periodo in corso non verranno più conteggiate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の期間の支出は数えられなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 기간의 지출은 더 이상 계산되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgaven van de huidige periode tellen niet meer mee."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As despesas do período atual deixarão de contar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расходы текущего периода больше не будут учитываться."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli dönemin harcamaları artık sayılmayacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前周期的支出将不再计入。"
          }
        }
      }
