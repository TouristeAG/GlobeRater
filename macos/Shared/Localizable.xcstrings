    "mac_reset_budget_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن تُحتسب مصاريف الفترة الحالية بعد الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgaben des laufenden Zeitraums zählen nicht mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expenses of the current period will no longer count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gastos del periodo actual dejarán de contar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses de la période en cours ne compteront plus."
          }
