    "mac_privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حساب ولا إحصاءات ولا إعلانات. لا يتصل GlobeRater إلا بـ openexchangerates.org (بمفتاحك) وopen-meteo.com (بالأماكن التي اخترتها)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto, keine Statistiken, keine Werbung. GlobeRater verbindet sich nur mit openexchangerates.org (mit deinem Schlüssel) und open-meteo.com (mit den gewählten Orten)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no analytics, no ads. GlobeRater only talks to openexchangerates.org (with your key) and open-meteo.com (with the places you chose)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin estadísticas, sin anuncios. GlobeRater solo se conecta a openexchangerates.org (con tu clave) y open-meteo.com (con los lugares que elegiste)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas de statistiques, pas de publicité. GlobeRater ne contacte que openexchangerates.org (avec votre clé) et open-meteo.com (avec les lieux choisis)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई अकाउंट नहीं, कोई आँकड़े नहीं, कोई विज्ञापन नहीं। GlobeRater केवल openexchangerates.org (आपकी कुंजी के साथ) और open-meteo.com (आपकी चुनी जगहों के साथ) से जुड़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa akun, tanpa statistik, tanpa iklan. GlobeRater hanya terhubung ke openexchangerates.org (dengan kunci Anda) dan open-meteo.com (dengan tempat yang Anda pilih)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, nessuna statistica, nessuna pubblicità. GlobeRater si collega solo a openexchangerates.org (con la tua chiave) e open-meteo.com (con i luoghi scelti)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントなし、統計なし、広告なし。GlobeRater が通信するのは openexchangerates.org（あなたのキーを使用）と open-meteo.com（選んだ場所を使用）だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정, 통계, 광고가 없습니다. GlobeRater는 openexchangerates.org(내 키 사용)와 open-meteo.com(선택한 장소 사용)에만 연결합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen account, geen statistieken, geen advertenties. GlobeRater maakt alleen verbinding met openexchangerates.org (met je sleutel) en open-meteo.com (met de gekozen plaatsen)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem estatísticas, sem anúncios. O GlobeRater só se conecta a openexchangerates.org (com sua chave) e open-meteo.com (com os lugares escolhidos)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без аккаунта, без статистики, без рекламы. GlobeRater обращается только к openexchangerates.org (с вашим ключом) и open-meteo.com (с выбранными местами)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yok, istatistik yok, reklam yok. GlobeRater yalnızca openexchangerates.org (anahtarınızla) ve open-meteo.com (seçtiğiniz yerlerle) ile iletişim kurar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无账户、无统计、无广告。GlobeRater 只连接 openexchangerates.org（使用你的密钥）和 open-meteo.com（使用你选择的地点）。"
          }
        }
      }
    },
