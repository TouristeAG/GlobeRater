    "mac_widgets_howto": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإضافة أداة: انقر بزر الماوس الأيمن على سطح المكتب، واختر تعديل الأدوات، ثم ابحث عن GlobeRater."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget hinzufügen: Rechtsklick auf den Schreibtisch, „Widgets bearbeiten“ wählen und nach GlobeRater suchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To add a widget: right-click the desktop, choose Edit Widgets, then search for GlobeRater."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para añadir un widget: haz clic derecho en el escritorio, elige Editar widgets y busca GlobeRater."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ajouter un widget : clic droit sur le bureau, choisissez Modifier les widgets, puis cherchez GlobeRater."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विजेट जोड़ने के लिए: डेस्कटॉप पर राइट-क्लिक करें, विजेट संपादित करें चुनें, फिर GlobeRater खोजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk menambahkan widget: klik kanan desktop, pilih Edit Widget, lalu cari GlobeRater."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per aggiungere un widget: fai clic destro sulla scrivania, scegli Modifica widget e cerca GlobeRater."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットを追加するには、デスクトップを右クリックして「ウィジェットを編集」を選び、GlobeRater を検索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯을 추가하려면 데스크탑을 오른쪽 클릭하고 위젯 편집을 선택한 다음 GlobeRater를 검색하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een widget toevoegen: klik met de rechtermuisknop op het bureaublad, kies Wijzig widgets en zoek GlobeRater."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para adicionar um widget: clique com o botão direito na mesa, escolha Editar widgets e procure GlobeRater."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы добавить виджет, нажмите правой кнопкой на рабочем столе, выберите «Изменить виджеты» и найдите GlobeRater."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget eklemek için masaüstüne sağ tıklayın, Widget'ları Düzenle'yi seçin ve GlobeRater'ı arayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加小组件：右键点按桌面，选择“编辑小组件”，然后搜索 GlobeRater。"
          }
        }
      }
    },
